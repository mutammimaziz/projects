# Shared secret between the two programs. Any random string; must not be blank.
BRIDGE_TOKEN=change-this-to-something-random

# Telegram API credentials from https://my.telegram.org (API development tools)
TG_API_ID=0000000
TG_API_HASH=replace_with_your_api_hash

# Local service settings - leave as-is unless port 3000 is taken
WA_PORT=3000
WA_SERVICE_URL=http://127.0.0.1:3000

# Optional: force a specific Chromium. Leave commented for auto-detection.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
