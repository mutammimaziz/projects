# Normalise to LF in the repository; check out Windows scripts as CRLF
* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.py   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf

# never touched by line-ending normalisation
*.session binary
*.png     binary
*.jpg     binary
